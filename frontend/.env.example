# Copy to .env.local, or let `bash scripts/deploy.sh` generate it for you.
#
# These are the addresses from the live testnet deployment recorded in
# deployments/testnet.json — enough to run the app against it without
# deploying anything yourself.
#
# Every NEXT_PUBLIC_* value is inlined into the client bundle at BUILD time, so
# changing one means rebuilding, not restarting. On a host like Vercel, set
# these five in the project's environment and redeploy.

NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Leave the semicolon unquoted and unescaped — this is the exact passphrase the
# network expects, and a truncated one produces signatures the network rejects.
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

NEXT_PUBLIC_REGISTRY_ID=CDF6NQL6ZDLI5B6WYVVDKR6PTOMCXPQHFHCBS5Y5DWQDFGPL4EMVRK3N
NEXT_PUBLIC_REPUTATION_ID=CCTRF56HY5G7HNGQZUUWEKX7OI7NYO55PR3XIU4ZZCCJ3CKUXSZIV3LP
NEXT_PUBLIC_TOKEN_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Optional. Defaults are chosen from NEXT_PUBLIC_STELLAR_NETWORK, so these are
# only needed to point at a private or self-hosted endpoint — the public
# testnet RPC is rate limited and can drop polls under load.
# NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
